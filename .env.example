# Server & AI Model Configuration
PORT=3001
NODE_ENV=development

# Google Gemma 2 (Open-Weights)
# Option 1: Local Ollama (Default: http://127.0.0.1:11434)
OLLAMA_URL=http://127.0.0.1:11434
GEMMA_MODEL=gemma2:9b

# Option 2: Gemma 2 via API (OpenRouter or Groq)
# GEMMA_API_KEY=your_gemma_or_openrouter_key_here
# GEMMA_API_URL=https://openrouter.ai/api/v1/chat/completions

# ElevenLabs Voice Synthesis (Optional - for spoken memorial eulogy)
# ELEVENLABS_API_KEY=your_elevenlabs_key_here
# ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB
